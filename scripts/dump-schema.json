{
  "_comment": "Allowlist for scripts/check-dump.py. tables: every table and column order the Worker's migrations create (a test keeps this equal to them) plus Cloudflare's own bookkeeping tables. A new table or column needs a reviewed edit here. hex_ids: columns that hold an opaque 32-hex id or keyed hash. numeric_text: text columns that hold plain counters or timestamps. patterns: a regex a value in that column (any table) must fully match. spaces_ok: column names (any table) whose values may hold spaces (place names).",
  "tables": {
    "_cf_KV": [
      "key",
      "value"
    ],
    "click_events": [
      "id",
      "ts",
      "link_id",
      "country",
      "site"
    ],
    "counters": [
      "key",
      "day",
      "count"
    ],
    "d1_migrations": [
      "id",
      "name",
      "applied_at"
    ],
    "kit_events": [
      "id",
      "ts",
      "lead_id",
      "kind"
    ],
    "kit_meta": [
      "key",
      "value"
    ],
    "leads": [
      "id",
      "email",
      "created_ts",
      "last_seen_ts",
      "verified_ts",
      "source",
      "country",
      "last_view_alert_ts",
      "last_view_event_ts",
      "last_cc_alert_ts",
      "session_floor_ts"
    ],
    "sqlite_sequence": [
      "name",
      "seq"
    ],
    "view_daily": [
      "site",
      "day",
      "day_tz",
      "page",
      "src_kind",
      "src",
      "country",
      "bot_class",
      "views",
      "uniques"
    ],
    "view_dim_daily": [
      "site",
      "day",
      "day_tz",
      "dim",
      "value",
      "bot_class",
      "views",
      "uniques"
    ],
    "view_events": [
      "id",
      "ts",
      "page",
      "src_kind",
      "src",
      "country",
      "region",
      "city",
      "browser",
      "bmajor",
      "os",
      "device",
      "lang",
      "vp",
      "net",
      "bot_class",
      "reason",
      "first",
      "site"
    ],
    "view_geo_daily": [
      "site",
      "day",
      "day_tz",
      "country",
      "region",
      "city",
      "bot_class",
      "views",
      "uniques"
    ],
    "view_meta": [
      "key",
      "value"
    ],
    "view_rollup_log": [
      "site",
      "day",
      "day_tz",
      "raw_views",
      "views",
      "uniques",
      "rows_core",
      "rows_dim",
      "rows_geo",
      "rolled_at",
      "max_id",
      "rerolls"
    ],
    "visitor_seen": [
      "day",
      "h"
    ]
  },
  "hex_ids": [
    "leads.id",
    "kit_events.lead_id",
    "visitor_seen.h"
  ],
  "numeric_text": [
    "view_meta.value",
    "kit_meta.value"
  ],
  "patterns": {
    "browser": "chrome|edge|firefox|safari|opera|samsung|brave|other",
    "os": "windows|macos|linux|android|ios|chromeos|other",
    "device": "mobile|tablet|desktop|other",
    "net": "residential|mobile|vpn-proxy|hosting-datacenter|tor|unknown",
    "bot_class": "[hvas]",
    "src_kind": "[dirou]",
    "lang": "([a-z]{2,3})?",
    "country": "([A-Z]{2})?"
  },
  "spaces_ok": [
    "city",
    "region"
  ]
}
