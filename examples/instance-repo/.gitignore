# Build output and scratch directories
out/
site-out/
dist/
# Deploy config generated on the runner or locally; it holds real ids
wrangler.deploy.toml
.wrangler/
# Checkout of the engine used for local deploys
engine/
# Secrets and local settings: never commit these
.env
.env.*
*.settings
# Backups written by the engine's edit commands
*.bak
# Undo history kept by the local editor
.reach-around-history/
# Editors and OS
.DS_Store
*.swp
# The history append lock (written beside history/social.jsonl by the engine)
history/.*.lock
# Leftovers of a history redaction (history-redact): a crash can leave the
# displaced OLD file, with the values being deleted, and its marker. Never commit.
history/.*.redact-*
