    "Live": {
      "additionalProperties": false,
      "description": "Twitch and Kick as co-equal players, link-outs, and VOD links.\n\nBoth players are required and keep the order written here; nothing at run\ntime reorders them. Channels are bare handles, never URLs.",
      "properties": {
        "also_on": {
          "items": {
            "$ref": "#/$defs/LiveAlsoOn"
          },
          "maxItems": 3,
          "title": "Also On",
          "type": "array"
        },
        "fediverse_note": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Fediverse coming soon",
          "title": "Fediverse Note"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "players": {
          "items": {
            "$ref": "#/$defs/LivePlayer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Players",
          "type": "array"
