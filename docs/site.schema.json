    "NumbersConfig": {
      "additionalProperties": false,
      "properties": {
        "sources": {
          "items": {
            "discriminator": {
              "mapping": {
                "bluesky": "#/$defs/BlueskySource",
                "discord": "#/$defs/DiscordSource",
                "github": "#/$defs/GithubSource",
                "mastodon": "#/$defs/MastodonSource",
                "matrix": "#/$defs/MatrixSource",
                "twitch": "#/$defs/TwitchSource",
                "youtube": "#/$defs/YoutubeSource"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/BlueskySource"
              },
              {
                "$ref": "#/$defs/MastodonSource"
