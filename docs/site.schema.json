            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mascot"
        },
        "mode": {
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "title": "Mode",
          "type": "string"
        },
        "radius": {
          "default": "0.5rem",
          "title": "Radius",
          "type": "string"
        }
      },
      "title": "Theme",
      "type": "object"
    }
  },
