    "Email": {
      "additionalProperties": false,
      "description": "A contact address kept out of the built page.\n\nThe HTML holds the address only reversed and base64 encoded in a data\nattribute; ``email.js`` assembles it. No ``@`` and no mail link is ever\nwritten to the output. Without script the page shows it spelled out.",
      "properties": {
        "address": {
          "title": "Address",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "reveal": {
          "default": "click",
          "enum": [
            "click",
            "always",
            "never_js"
          ],
          "title": "Reveal",
          "type": "string"
        },
        "spell": {
          "$ref": "#/$defs/EmailSpell",
          "default": {
            "at": "at",
            "dot": "dot"
          }
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "address",
        "id"
      ],
      "title": "Email",
      "type": "object"
    },
