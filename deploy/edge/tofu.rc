# SPDX-License-Identifier: Apache-2.0
#
# The only OpenTofu CLI configuration plan.sh uses (via TF_CLI_CONFIG_FILE). It
# installs exactly the locked Cloudflare provider straight from the registry and
# nothing else: no dev_overrides, no mirrors, no plugin cache. Hashes are checked
# against .terraform.lock.hcl. A change here is a reviewed change.
provider_installation {
  direct {
    include = ["registry.opentofu.org/cloudflare/cloudflare"]
  }
}
